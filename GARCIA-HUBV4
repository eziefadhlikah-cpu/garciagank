-- TELEPORT TO WAYPOINTS
local waypoints = {}
local function findWaypoints()
    for _, item in ipairs(workspace:GetDescendants()) do
        if item.Name:lower():find("waypoint") or item.Name:lower():find("checkpoint") or item.Name:lower():find("node") then
            if item:IsA("BasePart") or item:IsA("Model") then
                table.insert(waypoints, item)
            end
        end
    end
end

local function teleportHandler()
    findWaypoints()
    while true do
        wait(2)
        if features.teleport and #waypoints > 0 then
            for _, wp in ipairs(waypoints) do
                local pos = wp:IsA("Model") and wp.PrimaryPart and wp.PrimaryPart.Position or wp.Position
                if pos and character and character.HumanoidRootPart then
                    character.HumanoidRootPart.CFrame = CFrame.new(pos)
                    wait(1)
                end
            end
        end
    end
end

