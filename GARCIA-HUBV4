-- Deteksi struktur game
local function detectGameStructure()
    -- Deteksi nama game
    if game.PlaceId then
        gameData.gameName = tostring(game.PlaceId)
    end
    
    -- Cari lokasi Money
    local function searchMoney(obj, depth)
        if depth > 5 then return end
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("IntValue") or child:IsA("NumberValue") then
                local name = child.Name:lower()
                if name:find("money") or name:find("cash") or name:find("uang") or name:find("coin") or name:find("point") then
                    table.insert(gameData.moneyLocations, child)
                end
            elseif child:IsA("Folder") or child:IsA("Model") then
                searchMoney(child, depth + 1)
            end
        end
    end
    
    searchMoney(player, 0)
    searchMoney(player:FindFirstChild("leaderstats"), 0)
    searchMoney(replicatedStorage, 0)
    
    -- Cari Remote Events/Functions
    for _, item in ipairs(replicatedStorage:GetDescendants()) do
        if item:IsA("RemoteEvent") or item:IsA("RemoteFunction") then
            table.insert(gameData.remoteEvents, item)
        end
    end
    
    -- Cari VehicleSeat
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("VehicleSeat") then
            table.insert(gameData.vehicleSeats, item)
        end
    end
    
    print("[GARCIA-HUB] Detected:", #gameData.moneyLocations, "money locations")
    print("[GARCIA-HUB] Detected:", #gameData.remoteEvents, "remote events")
    print("[GARCIA-HUB] Detected:", #gameData.vehicleSeats, "vehicle seats")
end

detectGameStructure()

