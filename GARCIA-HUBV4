-- AUTO EARN MONEY (ADAPTIF)
local function autoEarnLoop()
    while true do
        wait(0.3)
        if features.autoEarn then
            -- Method 1: Langsung ubah nilai
            for _, money in ipairs(gameData.moneyLocations) do
                pcall(function()
                    money.Value = money.Value + 10000
                end)
            end
            
            -- Method 2: Remote event spoofing
            for _, remote in ipairs(gameData.remoteEvents) do
                pcall(function()
                    if remote.Name:lower():find("earn") or remote.Name:lower():find("money") or remote.Name:lower():find("drive") then
                        remote:FireServer("AddMoney", 10000)
                        remote:FireServer("Earn", 10000)
                        remote:FireServer("GetReward", 10000)
                    end
                end)
            end
            
            -- Method 3: GUI simulation (klik tombol jika ada)
            for _, btn in ipairs(player.PlayerGui:GetDescendants()) do
                if btn:IsA("TextButton") and (btn.Text:lower():find("claim") or btn.Text:lower():find("earn")) then
                    pcall(function() btn:Fire() end)
                end
            end
        end
    end
end

-- AUTO DRIVE
local function autoDriveLoop()
    while true do
        wait(0.5)
        if features.autoDrive then
            local vehicle = character:FindFirstChildOfClass("VehicleSeat")
            if not vehicle then
                for _, seat in ipairs(gameData.vehicleSeats) do
                    if seat and seat.Parent and (seat.Parent.Position - character.HumanoidRootPart.Position).Magnitude < 15 then
                        character.HumanoidRootPart.CFrame = seat.CFrame
                        vehicle = seat
                        break
                    end
                end
            end
            
            if vehicle then
                pcall(function()
                    vehicle.Throttle = 1
                    vehicle.Steer = math.sin(tick() * 1.5) * 0.7
                end)
            end
        end
    end
end

