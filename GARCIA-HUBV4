    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = tabFrame
    tabButtons[tabName] = btn
    
    btn.MouseButton1Click:Connect(function()
        currentTab = tabName
        for _, tb in pairs(tabButtons) do
            tb.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
            tb.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        btn.BackgroundColor3 = Color3.fromRGB(255, 0, 100)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        if tabName == "MAIN" then buildMainTab()
        elseif tabName == "DRIVING" then buildDrivingTab()
        elseif tabName == "PLAYER" then buildPlayerTab()
        elseif tabName == "EXPLOIT" then buildExploitTab()
        elseif tabName == "VISUAL" then buildVisualTab()
        elseif tabName == "SETTINGS" then buildSettingsTab()
        end
    end)
end

